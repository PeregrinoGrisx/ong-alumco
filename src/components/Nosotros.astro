---
import FlorSeccion from './FlorSeccion.astro';
import EmblemaValor from './EmblemaValor.astro';
import { nosotros, valores } from '../data/sitio';
---

<section id="nosotros" class="seccion">
  <div class="contenedor">
    <div class="nosotros">
      <div class="nosotros__texto">
        <p class="antetitulo"><FlorSeccion /> Nosotros</p>
        <h2 class="titulo-seccion" data-revelar>Un hogar donde la vejez florece.</h2>
        {nosotros.map((parrafo, i) => (
          <p class="nosotros__parrafo" data-revelar style={`--retraso: ${0.08 * (i + 1)}s`}>
            {parrafo}
          </p>
        ))}
      </div>

      <figure class="nosotros__figura panel" data-revelar style="--retraso: 0.15s">
        <img
          src="/img/personas-mayores.png"
          alt="Ilustración de una pareja de personas mayores caminando con bastón entre hojas."
          width="1222"
          height="1153"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <h3 class="valores__titulo" data-revelar>Nuestros valores</h3>
    <ul class="valores">
      {
        valores.map((v, i) => (
          <li class="valor panel" data-revelar style={`--retraso: ${0.07 * i}s`}>
            <EmblemaValor piezas={v.piezas} />
            <h4 class="valor__titulo">{v.titulo}</h4>
            <p class="valor__texto">{v.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nosotros {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .nosotros__parrafo {
    margin-top: 22px;
    max-width: 58ch;
    color: var(--tinta-suave);
  }

  .nosotros__parrafo:first-of-type {
    color: var(--tinta);
    font-size: clamp(1.1rem, 1.7vw, 1.25rem);
  }

  .nosotros__figura {
    margin: 0;
    padding: clamp(12px, 2vw, 24px);
    overflow: hidden;
  }

  .nosotros__figura img {
    width: 100%;
    height: auto;
    border-radius: var(--radio-sm);
  }

  .valores__titulo {
    margin-top: clamp(64px, 9vw, 110px);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }

  .valores {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .valor {
    padding: 26px 22px 28px;
  }

  .valor__titulo {
    margin: 18px 0 0;
    font-family: var(--fuente-titulo);
    font-size: 1.35rem;
    font-weight: 560;
    color: var(--azul-profundo);
  }

  .valor__texto {
    margin-top: 8px;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--tinta-suave);
  }

  @media (max-width: 1099px) {
    .valores {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 899px) {
    .nosotros {
      grid-template-columns: 1fr;
    }

    .nosotros__figura {
      max-width: 520px;
    }

    .valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 479px) {
    .valores {
      grid-template-columns: 1fr;
    }
  }
</style>
