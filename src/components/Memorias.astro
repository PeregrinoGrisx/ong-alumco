---
import FlorSeccion from './FlorSeccion.astro';
import { memorias } from '../data/sitio';

const colores = ['azul', 'verde', 'coral', 'ambar'];
---

<section id="memorias" class="seccion">
  <div class="contenedor">
    <div class="memorias__cabeza">
      <div>
        <p class="antetitulo"><FlorSeccion /> Memorias y transparencia</p>
        <h2 class="titulo-seccion" data-revelar>Cuentas claras, a la vista de todos.</h2>
      </div>
      <p class="bajada-seccion memorias__texto panel" data-revelar style="--retraso: 0.1s">{memorias.texto}</p>
    </div>

    <ul class="documentos">
      {
        memorias.documentos.map((doc, i) => (
          <li data-revelar style={`--retraso: ${0.05 * i}s; --acento: var(--${colores[i % colores.length]})`}>
            <a class="documento panel" href={doc.url} target="_blank" rel="noopener noreferrer">
              <span class="documento__icono" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path
                    d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2.2h7a2 2 0 0 1 2 2v8.3a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="documento__titulo">{doc.titulo}</span>
              <span class="documento__accion">
                Abrir carpeta
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M8 16L16 8M9.5 8H16v6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="visualmente-oculto">(se abre en Google Drive, en una pestaña nueva)</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .memorias__cabeza {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: end;
  }

  .memorias__texto {
    margin-top: 0;
    padding: clamp(20px, 2.6vw, 28px);
    font-size: 1.05rem;
  }

  .documentos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: clamp(36px, 5vw, 56px) 0 0;
    padding: 0;
    list-style: none;
  }

  .documento {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 22px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .documento:hover {
    border-color: var(--acento);
    background: #fff;
  }

  .documento__icono {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--azul-profundo);
    background: color-mix(in srgb, var(--acento) 28%, white);
  }

  .documento__titulo {
    font-family: var(--fuente-titulo);
    font-size: 1.25rem;
    font-weight: 560;
    line-height: 1.2;
    color: var(--azul-profundo);
  }

  .documento__accion {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--azul);
  }

  .documento:hover .documento__accion svg {
    transform: translate(2px, -2px);
  }

  .documento__accion svg {
    transition: transform 0.2s ease;
  }

  @media (max-width: 1099px) {
    .documentos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 899px) {
    .memorias__cabeza {
      grid-template-columns: 1fr;
    }

    .documentos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 419px) {
    .documentos {
      grid-template-columns: 1fr;
    }
  }
</style>
