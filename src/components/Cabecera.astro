---
import LogoMark from './LogoMark.astro';
import { navegacion } from '../data/sitio';
---

<header class="cabecera">
  <div class="contenedor cabecera__barra">
    <a class="marca" href="#inicio" aria-label="ONG Alumco, ir al inicio">
      <LogoMark size={38} />
      <span class="marca__nombre">alumco</span>
    </a>

    <button
      class="cabecera__menu"
      type="button"
      aria-expanded="false"
      aria-controls="navegacion"
    >
      <span class="visualmente-oculto">Abrir menú</span>
      <span class="cabecera__icono" aria-hidden="true"></span>
    </button>

    <nav id="navegacion" class="navegacion" aria-label="Principal">
      <ul>
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href}>{item.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
  }

  .cabecera:global(.con-fondo) {
    background: rgb(251 250 246 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--borde);
  }

  .cabecera__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .marca__nombre {
    font: 800 1.7rem/1 var(--fuente-texto);
    letter-spacing: -0.03em;
    color: var(--azul);
  }

  .navegacion ul {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navegacion a {
    display: block;
    padding: 10px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    color: var(--tinta);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .navegacion a:hover {
    background: rgb(57 94 159 / 0.09);
    color: var(--azul-profundo);
  }

  .navegacion li:last-child a {
    background: var(--azul);
    color: #fff;
    margin-left: 6px;
  }

  .navegacion li:last-child a:hover {
    background: var(--azul-profundo);
  }

  .cabecera__menu {
    display: none;
  }

  @media (max-width: 899px) {
    .cabecera__menu {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 0;
      border-radius: 14px;
      background: rgb(57 94 159 / 0.1);
      cursor: pointer;
    }

    .cabecera__icono,
    .cabecera__icono::before,
    .cabecera__icono::after {
      display: block;
      width: 22px;
      height: 2.5px;
      border-radius: 2px;
      background: var(--azul-profundo);
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .cabecera__icono {
      position: relative;
    }

    .cabecera__icono::before,
    .cabecera__icono::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .cabecera__icono::before {
      top: -7px;
    }

    .cabecera__icono::after {
      top: 7px;
    }

    .cabecera__menu[aria-expanded='true'] .cabecera__icono {
      background: transparent;
    }

    .cabecera__menu[aria-expanded='true'] .cabecera__icono::before {
      transform: translateY(7px) rotate(45deg);
    }

    .cabecera__menu[aria-expanded='true'] .cabecera__icono::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    .navegacion {
      position: absolute;
      inset: 76px 0 auto;
      padding: 8px var(--margen) 20px;
      background: rgb(251 250 246 / 0.97);
      box-shadow: 0 18px 30px -18px rgb(31 53 99 / 0.35);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }

    .navegacion:global(.abierta) {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .navegacion ul {
      flex-direction: column;
      gap: 4px;
    }

    .navegacion a {
      padding: 14px 16px;
      font-size: 1.1rem;
    }

    .navegacion li:last-child a {
      margin: 8px 0 0;
      text-align: center;
    }
  }
</style>
