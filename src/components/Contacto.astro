---
import FlorSeccion from './FlorSeccion.astro';
import { contacto } from '../data/sitio';
---

<section id="contacto" class="seccion">
  <div class="contenedor contacto">
    <div class="contacto__texto">
      <p class="antetitulo"><FlorSeccion /> Contacto</p>
      <h2 class="titulo-seccion" data-revelar>Conversemos.</h2>
      <p class="bajada-seccion" data-revelar style="--retraso: 0.08s">
        Escríbenos o síguenos en Instagram. Será un gusto contarte cómo cuidamos a nuestras personas mayores.
      </p>
    </div>

    <ul class="canales">
      {
        contacto.correos.map((c, i) => (
          <li data-revelar style={`--retraso: ${0.08 * i}s`}>
            <a class="canal panel" href={`mailto:${c.correo}`}>
              <span class="canal__icono canal__icono--correo" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <rect x="3" y="5.5" width="18" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <path d="M4 7.5l8 5.5 8-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="canal__etiqueta">{c.etiqueta}</span>
              <span class="canal__valor">{c.correo}</span>
            </a>
          </li>
        ))
      }
      <li data-revelar style="--retraso: 0.16s">
        <a class="canal panel" href={contacto.instagram.url} target="_blank" rel="noopener noreferrer">
          <span class="canal__icono canal__icono--instagram" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
          </span>
          <span class="canal__etiqueta">Instagram</span>
          <span class="canal__valor">{contacto.instagram.usuario}</span>
          <span class="visualmente-oculto">(se abre en una pestaña nueva)</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contacto {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .canales {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .canal {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 18px;
    align-items: center;
    padding: 20px 24px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .canal:hover {
    background: #fff;
    border-color: rgb(57 94 159 / 0.4);
  }

  .canal__icono {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: var(--azul-profundo);
  }

  .canal__icono--correo {
    background: rgb(175 221 131 / 0.45);
  }

  .canal__icono--instagram {
    background: rgb(255 99 100 / 0.22);
  }

  .canal__etiqueta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .canal__valor {
    font-family: var(--fuente-titulo);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 540;
    color: var(--azul-profundo);
    overflow-wrap: anywhere;
  }

  @media (max-width: 899px) {
    .contacto {
      grid-template-columns: 1fr;
    }
  }
</style>
