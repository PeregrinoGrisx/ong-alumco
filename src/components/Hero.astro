---
import { hero, marca } from '../data/sitio';
---

<section id="inicio" class="hero">
  <div class="contenedor hero__contenido">
    <p class="hero__sello" data-revelar>
      <span class="hero__punto" aria-hidden="true"></span>
      {marca.nombre} · {marca.establecimiento}
    </p>

    <h1 class="hero__titulo" data-revelar style="--retraso: 0.1s">
      Nuestros cuidados son <em>el reflejo de la empatía.</em>
    </h1>

    <p class="hero__bajada" data-revelar style="--retraso: 0.2s">{hero.bajada}</p>

    <div class="hero__acciones" data-revelar style="--retraso: 0.3s">
      <a class="boton boton--primario" href="#contacto">Contáctanos</a>
      <a class="boton boton--secundario" href="#memorias">Ver memorias</a>
    </div>
  </div>

  <a class="hero__pista" href="#validaciones">
    <span>Desliza y deja que florezca</span>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 120px 110px;
  }

  .hero__contenido {
    max-width: var(--ancho);
  }

  .hero__sello {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    border: 1px solid var(--borde);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--azul-profundo);
  }

  .hero__punto {
    width: 10px;
    height: 10px;
    background: var(--coral);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .hero__titulo {
    margin-top: 26px;
    max-width: 13ch;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    font-weight: 520;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .hero__titulo em {
    font-style: italic;
    font-weight: 460;
    color: var(--coral-texto);
  }

  .hero__bajada {
    margin-top: 26px;
    max-width: 34ch;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--tinta-suave);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .hero__pista {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tinta-suave);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__pista svg {
    animation: bajar 1.8s ease-in-out infinite;
  }

  @keyframes bajar {
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-width: 899px) {
    .hero {
      align-items: start;
      padding-top: 118px;
    }

    /* En móvil el capullo ocupa ese espacio y ya invita a deslizar. */
    .hero__pista {
      display: none;
    }

    .hero__titulo {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pista svg {
      animation: none;
    }
  }
</style>
